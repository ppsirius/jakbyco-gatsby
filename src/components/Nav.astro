---
const links = [
  { label: 'About', href: '/#about' },
  { label: 'Projects', href: '/#projects' },
  { label: 'Blog', href: '/blog' },
  { label: 'Contact', href: '/#contact' },
];
---

<nav
  class="fixed top-0 left-0 right-0 z-50"
  style="background-color: var(--bg); border-bottom: 1px solid var(--border);"
>
  <div class="flex items-center justify-between px-6 md:px-10 h-14">
    <!-- Logo -->
    <a
      href="/"
      class="label-text hover:opacity-60 transition-opacity"
      style="color: var(--fg);"
    >
      jakbyco.com
    </a>

    <!-- Nav links -->
    <ul class="hidden md:flex items-center">
      {links.map((link) => (
        <li>
          <a
            href={link.href}
            class="label-text px-4 py-5 inline-block hover:opacity-60 transition-opacity"
            style="color: var(--fg); border-left: 1px solid var(--border);"
          >
            {link.label}
          </a>
        </li>
      ))}

      <!-- Theme toggle -->
      <li>
        <button
          id="theme-toggle"
          aria-label="Toggle light/dark theme"
          class="label-text px-4 py-5 inline-flex items-center gap-2 hover:opacity-60 transition-opacity cursor-pointer"
          style="color: var(--fg); border-left: 1px solid var(--border);"
        >
          <span id="theme-icon" style="display:inline-flex;align-items:center;">
            <!-- Sun icon (shown in dark mode) -->
            <svg
              id="icon-sun"
              xmlns="http://www.w3.org/2000/svg"
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              style="display:none;"
            >
              <circle cx="12" cy="12" r="5" />
              <line x1="12" y1="1" x2="12" y2="3" />
              <line x1="12" y1="21" x2="12" y2="23" />
              <line x1="4.22" y1="4.22" x2="5.64" y2="5.64" />
              <line x1="18.36" y1="18.36" x2="19.78" y2="19.78" />
              <line x1="1" y1="12" x2="3" y2="12" />
              <line x1="21" y1="12" x2="23" y2="12" />
              <line x1="4.22" y1="19.78" x2="5.64" y2="18.36" />
              <line x1="18.36" y1="5.64" x2="19.78" y2="4.22" />
            </svg>
            <!-- Moon icon (shown in light mode) -->
            <svg
              id="icon-moon"
              xmlns="http://www.w3.org/2000/svg"
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              style="display:none;"
            >
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
            </svg>
          </span>
          <span id="theme-label">Light</span>
        </button>
      </li>
    </ul>

    <!-- Mobile menu button -->
    <button
      id="mobile-menu-toggle"
      aria-label="Toggle mobile menu"
      class="md:hidden flex flex-col gap-1.5 p-2 hover:opacity-60 transition-opacity cursor-pointer"
    >
      <span class="block w-5 h-px" style="background: var(--fg);"></span>
      <span class="block w-5 h-px" style="background: var(--fg);"></span>
      <span class="block w-3 h-px" style="background: var(--fg);"></span>
    </button>
  </div>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    class="md:hidden hidden"
    style="border-top: 1px solid var(--border);"
  >
    {links.map((link) => (
      <a
        href={link.href}
        class="label-text block px-6 py-4 hover:opacity-60 transition-opacity"
        style="color: var(--fg); border-bottom: 1px solid var(--border);"
      >
        {link.label}
      </a>
    ))}
    <button
      id="mobile-theme-toggle"
      class="label-text w-full px-6 py-4 inline-flex items-center gap-2 hover:opacity-60 transition-opacity cursor-pointer"
      style="color: var(--fg); border-bottom: 1px solid var(--border);"
    >
      <span style="display:inline-flex;align-items:center;">
        <svg
          id="mobile-icon-sun"
          xmlns="http://www.w3.org/2000/svg"
          width="14" height="14" viewBox="0 0 24 24"
          fill="none" stroke="currentColor" stroke-width="2"
          style="display:none;"
        >
          <circle cx="12" cy="12" r="5" />
          <line x1="12" y1="1" x2="12" y2="3" />
          <line x1="12" y1="21" x2="12" y2="23" />
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64" />
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78" />
          <line x1="1" y1="12" x2="3" y2="12" />
          <line x1="21" y1="12" x2="23" y2="12" />
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36" />
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22" />
        </svg>
        <svg
          id="mobile-icon-moon"
          xmlns="http://www.w3.org/2000/svg"
          width="14" height="14" viewBox="0 0 24 24"
          fill="none" stroke="currentColor" stroke-width="2"
          style="display:none;"
        >
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
        </svg>
      </span>
      <span id="mobile-theme-label">Light</span>
    </button>
  </div>
</nav>

<!-- Theme toggle: is:inline so it runs synchronously (no flash) -->
<script is:inline>
  (function () {
    function applyTheme(theme) {
      if (theme === 'light') {
        document.documentElement.setAttribute('data-theme', 'light');
        localStorage.setItem('theme', 'light');
      } else {
        document.documentElement.removeAttribute('data-theme');
        localStorage.setItem('theme', 'dark');
      }
      updateIcons();
    }

    function getTheme() {
      return document.documentElement.getAttribute('data-theme') === 'light'
        ? 'light'
        : 'dark';
    }

    function updateIcons() {
      const theme = getTheme();
      const isDark = theme === 'dark';

      const ids = [
        { sun: 'icon-sun', moon: 'icon-moon', label: 'theme-label' },
        { sun: 'mobile-icon-sun', moon: 'mobile-icon-moon', label: 'mobile-theme-label' },
      ];

      ids.forEach(function (set) {
        const sun = document.getElementById(set.sun);
        const moon = document.getElementById(set.moon);
        const label = document.getElementById(set.label);
        if (sun) sun.style.display = isDark ? 'inline' : 'none';
        if (moon) moon.style.display = isDark ? 'none' : 'inline';
        if (label) label.textContent = isDark ? 'Light' : 'Dark';
      });
    }

    function toggleTheme() {
      applyTheme(getTheme() === 'dark' ? 'light' : 'dark');
    }

    document.addEventListener('DOMContentLoaded', function () {
      updateIcons();

      const toggle = document.getElementById('theme-toggle');
      if (toggle) toggle.addEventListener('click', toggleTheme);

      const mobileToggle = document.getElementById('mobile-theme-toggle');
      if (mobileToggle) mobileToggle.addEventListener('click', toggleTheme);

      const mobileMenuToggle = document.getElementById('mobile-menu-toggle');
      const mobileMenu = document.getElementById('mobile-menu');
      if (mobileMenuToggle && mobileMenu) {
        mobileMenuToggle.addEventListener('click', function () {
          const isHidden = mobileMenu.classList.contains('hidden');
          mobileMenu.classList.toggle('hidden', !isHidden);
        });
      }
    });
  })();
</script>

<!-- GSAP smooth-scroll for anchor nav links (bundled by Astro/Vite) -->
<script>
  import { gsap } from 'gsap';
  import { ScrollToPlugin } from 'gsap/ScrollToPlugin';

  gsap.registerPlugin(ScrollToPlugin);

  const NAV_HEIGHT = 56; // px — matches h-14

  function scrollToAnchor(hash: string) {
    const target = document.querySelector(hash);
    if (!target) return;
    gsap.to(window, {
      scrollTo: { y: target, offsetY: NAV_HEIGHT },
      duration: 1.1,
      ease: 'power3.inOut',
    });
  }

  document.addEventListener('DOMContentLoaded', () => {
    // Intercept all anchor links that point to /#section
    document.querySelectorAll<HTMLAnchorElement>('a[href^="/#"]').forEach((link) => {
      link.addEventListener('click', (e) => {
        // Only apply on home page (one-page layout)
        if (window.location.pathname !== '/') return;

        e.preventDefault();
        const hash = link.getAttribute('href')!.slice(1); // "/#about" → "#about"
        scrollToAnchor(hash);

        // Close mobile menu if open
        document.getElementById('mobile-menu')?.classList.add('hidden');
      });
    });

    // If page loads with a hash (e.g. direct link to /#projects), animate to it
    if (window.location.hash && window.location.pathname === '/') {
      // Small delay so the page has rendered
      setTimeout(() => scrollToAnchor(window.location.hash), 100);
    }
  });
</script>
