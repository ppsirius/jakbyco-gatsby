---
const projects = [
  {
    title: 'Nowbruk',
    href: 'https://nowbruk-git-master-jakbyco.vercel.app/',
    description: 'Website for paving services. Used Gatsby and Prismic.io for content management.',
    tags: ['Gatsby', 'Prismic.io'],
  },
  {
    title: 'Inveo',
    href: 'https://github.com/ppsirius/inveo',
    description: 'Website for Cosmetics Brand. Used Gatsby and Rebass, focusing on RWD and page load time.',
    tags: ['Gatsby', 'Rebass', 'RWD'],
  },
  {
    title: 'Google Maps Marker',
    href: 'https://cranky-swanson-3753ae.netlify.com',
    description: 'Maps with marker editor based on Vue, Vuex, Google Maps API and Snazzy Maps.',
    tags: ['Vue', 'Vuex', 'Google Maps API'],
  },
  {
    title: 'SVG animation with clip paths',
    href: 'https://codepen.io/ppsirius/pen/PLmaZa',
    description: 'Practice example with SVG possibilities.',
    tags: ['SVG', 'CSS', 'Animation'],
  },
  {
    title: 'Simple Gym Web App on mobile',
    href: 'https://compassionate-dijkstra-7a87d4.netlify.com/',
    description: 'Useful example about simple transitions animation in Vue.',
    tags: ['Vue', 'Animation'],
  },
  {
    title: '3D Game in A-Frame',
    href: 'https://quack-hunter.netlify.com/',
    description: 'First game in VR using awesome library A-Frame.',
    tags: ['A-Frame', 'VR', 'WebXR'],
  },
  {
    title: 'Wave effect on Canvas',
    href: 'https://codepen.io/ppsirius/full/dZmxRE/',
    description: 'Effect example rendered on canvas using React with PIXI.js.',
    tags: ['React', 'PIXI.js', 'Canvas'],
  },
  {
    title: 'Minimalistic Portfolio',
    href: 'http://pariaszewski.com/',
    description: 'Portfolio website for a good friend who is a big fan of minimalism.',
    tags: ['Portfolio', 'Performance'],
  },
  {
    title: 'Boilerplate for Tizen TV App',
    href: 'https://github.com/ppsirius/tizen-boilerplate',
    description: 'Useful boilerplate for fast creation and deploying App on Tizen TV Platform.',
    tags: ['Tizen', 'TV App'],
  },
  {
    title: 'SVG and CSS loader',
    href: 'https://codepen.io/ppsirius/pen/vKEeeq',
    description: 'The SVG loader with smooth CSS animation.',
    tags: ['SVG', 'CSS', 'Animation'],
  },
];
---

<section
  id="projects"
  style="border-top: 1px solid var(--border);"
>
  <!-- Section header — padded -->
  <div class="px-6 md:px-10 pt-16 md:pt-20 pb-8 reveal">
    <p class="label-text mb-2" style="color: var(--fg-muted);">Selected Work</p>
    <div class="flex items-end justify-between">
      <h2
        class="font-bold leading-none"
        style="font-size: clamp(2rem, 4vw, 3rem); letter-spacing: -0.02em; color: var(--fg);"
      >
        Projects
      </h2>
      <p class="label-text hidden md:block" style="color: var(--fg-subtle);">
        {projects.length} Projects
      </p>
    </div>
  </div>

  <!-- Rows — full-width, borders touch screen edges -->
  <div style="border-top: 1px solid var(--border);">
    {projects.map((project, index) => (
      <a
        href={project.href}
        target="_blank"
        rel="noopener noreferrer"
        class={`group flex items-center justify-between px-6 md:px-10 py-5 md:py-6 reveal reveal-delay-${Math.min(index % 4 + 1, 4)}`}
        style="border-bottom: 1px solid var(--border);"
      >
        <!-- Left: index + title + description -->
        <div class="flex items-center gap-4 md:gap-8 flex-1 min-w-0">
          <span
            class="label-text flex-shrink-0 w-6 text-right"
            style="color: var(--fg-subtle);"
          >
            {String(index + 1).padStart(2, '0')}
          </span>

          <div class="flex-1 min-w-0">
            <h3
              class="font-semibold truncate"
              style="font-size: clamp(0.95rem, 2vw, 1.15rem); color: var(--fg); letter-spacing: -0.01em;"
            >
              {project.title}
            </h3>
            <p
              class="text-sm mt-0.5 truncate hidden md:block"
              style="color: var(--fg-subtle);"
            >
              {project.description}
            </p>
          </div>
        </div>

        <!-- Right: tags + arrow -->
        <div class="flex items-center gap-4 md:gap-8 flex-shrink-0 ml-4">
          <div class="hidden lg:flex gap-2">
            {project.tags.slice(0, 2).map((tag) => (
              <span
                class="label-text px-2 py-1"
                style="color: var(--fg-subtle); border: 1px solid var(--border);"
              >
                {tag}
              </span>
            ))}
          </div>

          <div class="flex items-center gap-2 label-text" style="color: var(--fg-subtle);">
            <span class="hidden md:inline">View</span>
            <span
              class="transition-transform duration-200 group-hover:translate-x-1 inline-block text-base"
              style="color: var(--fg);"
            >→</span>
          </div>
        </div>
      </a>
    ))}
  </div>

  <!-- Bottom spacer -->
  <div class="pb-16 md:pb-20"></div>
</section>
