---
import SocialLinks from './SocialLinks.astro';
---

<section class="relative min-h-screen flex flex-col justify-end overflow-hidden">
  <!-- Background image with overlay -->
  <div class="absolute inset-0 z-0">
    <img
      src="/images/image-large.jpg"
      alt="Background"
      class="w-full h-full object-cover"
      style="filter: brightness(0.25) contrast(1.1);"
    />
    <!-- Gradient overlay -->
    <div
      class="absolute inset-0"
      style="background: linear-gradient(to bottom, transparent 30%, var(--bg) 100%);"
    ></div>
  </div>

  <!-- Eyebrow label -->
  <div
    class="absolute top-1/3 left-6 md:left-10 z-10 reveal"
    style="border-left: 2px solid var(--fg); padding-left: 12px;"
  >
    <p class="label-text" style="color: var(--fg-muted);">Frontend Developer</p>
    <p class="label-text" style="color: var(--fg-muted);">Warsaw / 2024–Present</p>
  </div>

  <!-- Main headline -->
  <div class="relative z-10 px-6 md:px-10 pb-16 md:pb-20">
    <div class="max-w-7xl mx-auto">
      <div class="reveal">
        <h1
          class="font-bold leading-none tracking-tight uppercase"
          style="font-size: clamp(3.5rem, 11vw, 10rem); color: var(--fg);"
        >
          Coding<br />nice<br />things.
        </h1>
      </div>

      <!-- Divider row -->
      <div
        class="flex items-center gap-6 mt-8 mb-8 reveal reveal-delay-1"
        style="border-top: 1px solid var(--border); padding-top: 1.5rem;"
      >
        <p class="label-text" style="color: var(--fg-muted);">Piotr Pupczyk</p>
        <span style="color: var(--border);">—</span>
        <p class="label-text" style="color: var(--fg-muted);">makes me happy.</p>

        <div class="flex-1"></div>

        <!-- Scroll hint -->
        <div class="hidden md:flex items-center gap-2 reveal reveal-delay-2">
          <span class="label-text" style="color: var(--fg-subtle);">Scroll</span>
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            style="color: var(--fg-subtle); animation: bounce 2s infinite;"
          >
            <path d="M12 5v14M5 12l7 7 7-7" />
          </svg>
        </div>
      </div>

      <!-- Social links row -->
      <div class="reveal reveal-delay-2">
        <SocialLinks />
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes bounce {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(5px); }
  }
</style>
