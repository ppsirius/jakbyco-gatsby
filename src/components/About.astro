---
const bio = [
  "Hi, I'm Piotrek, I'm a Software Engineer.",
  "I have a graphic design background.",
  "I am passionate about innovation.",
  "I love good design and motion.",
];

const details = [
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>`,
    text: 'Warsaw',
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>`,
    text: 'ERGO Technology & Services',
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>`,
    text: 'Akademia Gorila',
    href: 'https://web.facebook.com/GorilaAcademia/',
  },
];
---

<section id="about" class="py-24 px-6 max-w-4xl mx-auto">
  <div class="mb-12">
    <h2 class="text-3xl md:text-5xl font-bold text-white leading-tight mb-2">
      Coding nice things
    </h2>
    <h2 class="text-3xl md:text-5xl font-bold text-white/60 leading-tight mb-12">
      makes me happy.
    </h2>
    <div class="w-16 h-px bg-white/40 mb-10"></div>
  </div>

  <div class="space-y-3 mb-10">
    {bio.map((line) => (
      <p class="text-white/90 text-lg md:text-xl">{line}</p>
    ))}
  </div>

  <ul class="space-y-3">
    {details.map((detail) => (
      <li class="flex items-center gap-3 text-white/70">
        <span class="text-white/50 flex-shrink-0" set:html={detail.icon} />
        {detail.href ? (
          <a
            href={detail.href}
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-white transition-colors"
          >
            {detail.text}
          </a>
        ) : (
          <span>{detail.text}</span>
        )}
      </li>
    ))}
  </ul>
</section>
