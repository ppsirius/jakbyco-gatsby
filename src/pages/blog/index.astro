---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}
---

<Layout
  title="Blog — Piotr Pupczyk"
  description="Thoughts on frontend development, design, and the web."
>
  <Nav />
  <main class="min-h-screen pt-24 pb-16 px-6 max-w-3xl mx-auto">
    <header class="mb-16 mt-8">
      <a href="/" class="text-white/40 hover:text-white/70 transition-colors text-sm mb-6 inline-block">
        ← Back to portfolio
      </a>
      <h1 class="text-4xl md:text-5xl font-bold text-white">Blog</h1>
      <p class="text-white/60 mt-3 text-lg">
        Thoughts on frontend development, design, and the web.
      </p>
    </header>

    {posts.length === 0 ? (
      <p class="text-white/50">No posts yet. Check back soon.</p>
    ) : (
      <ul class="space-y-8">
        {posts.map((post) => (
          <li>
            <a
              href={`/blog/${post.id}`}
              class="group block p-6 border border-white/10 rounded-lg hover:border-white/30 hover:bg-white/5 transition-all duration-300"
            >
              <time
                datetime={post.data.pubDate.toISOString()}
                class="text-white/40 text-sm"
              >
                {formatDate(post.data.pubDate)}
              </time>
              <h2 class="text-white text-xl font-semibold mt-2 mb-2 group-hover:text-white/90">
                {post.data.title}
                <span class="inline-block ml-2 opacity-0 group-hover:opacity-100 transition-opacity">→</span>
              </h2>
              <p class="text-white/60 text-sm leading-relaxed">{post.data.description}</p>
              <div class="flex flex-wrap gap-2 mt-4">
                {post.data.tags.map((tag: string) => (
                  <span class="text-xs text-white/40 bg-white/5 px-2 py-0.5 rounded">
                    #{tag}
                  </span>
                ))}
              </div>
            </a>
          </li>
        ))}
      </ul>
    )}
  </main>
</Layout>
