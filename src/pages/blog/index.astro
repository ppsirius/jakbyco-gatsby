---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  });
}
---

<Layout
  title="Blog — Piotr Pupczyk"
  description="Thoughts on frontend development, design, and the web."
>
  <Nav />
  <main class="min-h-screen pt-14">

    <!-- Page header -->
    <div
      class="px-6 md:px-10 py-16 md:py-24"
      style="border-bottom: 1px solid var(--border);"
    >
      <a
        href="/"
        class="label-text inline-flex items-center gap-2 mb-10 hover:opacity-60 transition-opacity"
        style="color: var(--fg-muted);"
      >
        <span>←</span>
        <span>Back to portfolio</span>
      </a>
      <div class="reveal">
        <p class="label-text mb-3" style="color: var(--fg-muted);">Writing</p>
        <h1
          class="font-bold leading-none"
          style="font-size: clamp(3rem, 8vw, 7rem); letter-spacing: -0.03em; color: var(--fg);"
        >
          Blog
        </h1>
      </div>
    </div>

    <!-- Posts list -->
    {posts.length === 0 ? (
      <div class="px-6 md:px-10 py-20">
        <p class="label-text" style="color: var(--fg-subtle);">No posts yet. Check back soon.</p>
      </div>
    ) : (
      <div>
        {posts.map((post, index) => (
          <a
            href={`/blog/${post.id}`}
            class={`group flex items-start md:items-center justify-between gap-6 px-6 md:px-10 py-7 reveal reveal-delay-${Math.min(index + 1, 4)}`}
            style="border-bottom: 1px solid var(--border); display: flex;"
          >
            <!-- Left: date + title + desc -->
            <div class="flex-1 min-w-0">
              <time
                datetime={post.data.pubDate.toISOString()}
                class="label-text block mb-2"
                style="color: var(--fg-subtle);"
              >
                {formatDate(post.data.pubDate)}
              </time>
              <h2
                class="font-semibold mb-1 transition-opacity duration-200 group-hover:opacity-70"
                style="font-size: clamp(1rem, 2vw, 1.25rem); color: var(--fg); letter-spacing: -0.01em;"
              >
                {post.data.title}
              </h2>
              <p class="text-sm leading-relaxed" style="color: var(--fg-subtle);">
                {post.data.description}
              </p>
              <div class="flex flex-wrap gap-2 mt-3">
                {post.data.tags.map((tag: string) => (
                  <span
                    class="label-text px-2 py-1"
                    style="color: var(--fg-subtle); border: 1px solid var(--border);"
                  >
                    #{tag}
                  </span>
                ))}
              </div>
            </div>

            <!-- Arrow -->
            <span
              class="flex-shrink-0 text-lg transition-transform duration-200 group-hover:translate-x-1 mt-1"
              style="color: var(--fg);"
            >
              →
            </span>
          </a>
        ))}
      </div>
    )}

    <!-- Footer bar -->
    <div
      class="px-6 md:px-10 py-6 flex items-center justify-between"
      style="border-top: 1px solid var(--border); margin-top: auto;"
    >
      <p class="label-text" style="color: var(--fg-subtle);">&copy; {new Date().getFullYear()} Piotr Pupczyk</p>
      <a
        href="/"
        class="label-text hover:opacity-60 transition-opacity"
        style="color: var(--fg-muted);"
      >
        jakbyco.com
      </a>
    </div>

  </main>
</Layout>
