---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
---

<Layout title="404 — Page Not Found">
  <Nav />
  <main class="min-h-screen flex flex-col items-center justify-center text-center px-6">
    <p class="label-text mb-6" style="color: var(--fg-subtle);">Error</p>
    <h1
      class="font-bold leading-none mb-6"
      style="font-size: clamp(6rem, 20vw, 16rem); letter-spacing: -0.05em; color: var(--fg-faint);"
    >
      404
    </h1>
    <p
      class="font-semibold mb-3 uppercase tracking-widest"
      style="font-size: 1.25rem; color: var(--fg);"
    >
      Page Not Found
    </p>
    <p class="text-sm mb-10" style="color: var(--fg-subtle);">
      The page you're looking for doesn't exist.
    </p>
    <a
      href="/"
      class="inline-flex items-center gap-3 group"
    >
      <span
        class="label-text group-hover:opacity-60 transition-opacity"
        style="color: var(--fg); border-bottom: 1px solid var(--border); padding-bottom: 2px;"
      >
        Go home
      </span>
      <span
        class="transition-transform duration-200 group-hover:translate-x-1"
        style="color: var(--fg-muted);"
      >→</span>
    </a>
  </main>
</Layout>
